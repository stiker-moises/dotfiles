	(y n m) 		(macro m a n y spc)				40 all-released (qwerty)
	(y o r) 		(macro y o u r spc)				40 all-released (qwerty)
	(y o t) 		(macro y o u t u b e)				40 all-released (qwerty)
	(y o v)			(macro e v e r y o n e spc)		40 all-released (qwerty)
	(y r w)			(macro w o u l d spc y o u spc r a t h e r spc)		40 all-released (qwerty)
	;; suffixes and punctuation
	(' t n) 		(macro bspc n ' t spc)					40 all-released (qwerty)
	(' u s) 		(macro bspc ' s spc)					40 all-released (qwerty)
	(bspc ' d)		(macro bspc ' d spc)		40 all-released (qwerty)
	(bspc ' l)		(macro bspc ' l l spc)		40 all-released (qwerty)
	(bspc ' m)		(macro bspc ' m spc)		40 all-released (qwerty)
	(bspc ' r e)	(macro bspc ' r e spc)		40 all-released (qwerty)
	(bspc ' s)		(macro bspc ' s spc)		40 all-released (qwerty)
	(bspc ' v)		(macro bspc ' v e spc)		40 all-released (qwerty)
	(bspc e d) 		(macro bspc e d spc)					40 all-released (qwerty)
	(bspc y l) 		(macro bspc l y spc)					40 all-released (qwerty)
	(g i n)			(macro bspc i n g spc)		40 all-released (qwerty)
	(bspc ,)		(macro bspc , spc)		40 all-released (qwerty)
	(bspc .)		(macro bspc . spc)		40 all-released (qwerty)
	(bspc ;)		(macro bspc ; spc)		40 all-released (qwerty)
	(bspc 1)		(macro bspc S-1 spc)		40 all-released (qwerty)
	(bspc ')		(macro bspc ')		40 all-released (qwerty)
	(bspc ' lsft)	(macro bspc S-' spc)		40 all-released (qwerty)
	(bspc lsft ;)	(macro bspc S-; spc)		40 all-released (qwerty)
	(/ spc)			(macro bspc /)		40 all-released (qwerty)
	(/ lsft spc)	(macro bspc S-/ spc)		40 all-released (qwerty)
	(- spc)			(macro bspc - spc)		40 all-released (qwerty)
)
