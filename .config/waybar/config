{
	"height": 26,
	"layer": "top",
	"position": "bottom",
	"modules-left": [
		"hyprland/workspaces",
//		"ext/workspaces",
		"custom/space",
		"hyprland/submap",
	],
	"modules-center": [
		"clock#1",
		"clock#2",
		"clock#3"
	],
	"modules-right": [
		"hyprland/window",
		"group/network",
		"group/battery",
		"group/audio",
		"pulseaudio#source",
		"privacy",
		"group/misc",
		"tray"
	],
	"hyprland/workspaces": {
		"all-outputs": false,
		"disable-scroll-wraparound": true,
		"enable-bar-scroll": true,
		"show-special": true,
		"smooth-scrolling-threshold": "4"
	},
	"ext/workspaces": {
		"all-outputs": false,
		"disable-scroll-wraparound": true,
		"enable-bar-scroll": true,
		"format": "{name}",
		"show-special": true,
		"smooth-scrolling-threshold": "4"
	},
	"clock#1": {
		"format": "{:%a}",
		"tooltip": false
	},
	"clock#2": {
		"actions":  {
			"on-click-right": "mode"
		},
		"calendar": {
			"format": {
				"days":       "<span color='#ffffff'>{}</span>",
				"months":     "<span color='#ffffff'><b>{}</b></span>",
				"today":      "<span color='#ff0000'><b><u>{}</u></b></span>",
				"weekdays":   "<span color='#cc0000'><b>{}</b></span>",
				"weeks":      "<span color='#ff0000'><b>W{}</b></span>"
			},
			"mode": "month",
			"mode-mon-col" : 3,
			"on-scroll" : 1,
			"weeks-pos" : "right"
		},
		"format": "{:%H:%M}",
		"interval": 1,
		"on-click": "qtalarm --toggleOnDup",
		"tooltip-format": "  <big>   {:%H:%M:%S}</big>\n<tt><small>{calendar}</small></tt>"
	},
	"clock#3": {
		"format": "{:%m-%d}",
		"tooltip": false
	},
	"idle_inhibitor": {
		"format": "{icon:1}",
		"format-icons": {
			"activated": "󰅶",
			"deactivated": "󰾪"
		},
		"tooltip": false
	},
	"network#icon": {
		"format": "",
		"format-disconnected": "󰤭",
		"format-ethernet": "",
		"format-linked": "",
		"format-icons": {
			"wifi": [
				"󰤯",
				"<span color=\"#cc0000\">󰤟</span>",
				"<span color=\"#d34800\">󰤟</span>",
				"<span color=\"#d56e00\">󰤟</span>",
				"<span color=\"#d58f00\">󰤟</span>",
				"<span color=\"#d2ae00\">󰤟</span>",
				"<span color=\"#cccc00\">󰤥</span>",
				"<span color=\"#bdd600\">󰤥</span>",
				"<span color=\"#a9e100\">󰤥</span>",
				"<span color=\"#68f500\">󰤥</span>",
				"<span color=\"#00ff00\">󰤨</span>" ]
		},
		"format-wifi": "{icon:1}",
		"tooltip": false,
		"on-click": "iwgtk"
	},
	"network#ssid": {
		"format": "",
		"format-disconnected": "",
		"format-ethernet": "",
		"format-linked": "",
		"format-wifi": "{essid} {signalStrength:2}",
		"max-length": 50,
		"on-click": "iwgtk",
		"tooltip": false
	},
	"pulseaudio#sink": {
		"format": "{volume:2} {icon:1}",
		"format-bluetooth": "{volume:2} {icon:1}",
		"format-icons": {
			"alsa_output.usb-Creative_Technology_Ltd_Sound_Blaster_X4.iec958-stereo": "󰋋",
			"alsa_output.usb-Creative_Technology_Ltd_Sound_Blaster_X4.iec958-stereo-muted": "󰟎",
			"car": "󰄋",
			"car-muted": "󰸜",
			"default": ["󰖀", "󰕾"],
			"default-muted": "󰝟",
			"hands-free": "󱡏",
			"hands-free-muted": "󱡐",
			"hdmi": "󰔂",
			"hdmi-muted": "󰠻",
			"headphone": "󰋋",
			"headphone-muted": "󰟎",
			"headset": "󰋎",
			"headset-muted": "󰋐",
			"phone": "󰏲",
			"phone-muted": "󰷯",
			"portable": "󰏲",
			"portable-muted": "󰷯"
		},
		"format-muted": "{volume:2} {icon:1}",
		"ignored-sinks": ["Easy Effects Sink"],
		"on-click": "pkill -15 pavucontrol ; pavucontrol",
		"on-click-middle": "wpctl set-default $(pw-dump | jaq -r '.[]|select(.type==\"PipeWire:Interface:Node\" and .info.props[\"media.class\"]==\"Audio/Sink\")|[.id,.info.props[\"node.name\"],.info.props[\"node.description\"]]|@tsv' | awk -F'\\t' -v d=\"$(wpctl inspect @DEFAULT_AUDIO_SINK@|awk -F'\\\"' '/node.name/{print $2;exit}')\" 'BEGIN{c=\"walker -x -d -p \\\"Audio Device: \\\"\"}$2!=d&&$2!=\"easyeffects_sink\"{a[$3]=$1;devs++;print $3|&c}END{if(devs>1){close(c,\"to\");c|&getline p;if(p!=\"\"){print a[p];system(\"notify-send --urgency=low --icon=/run/current-system/sw/share/icons/Flat-Remix-Red-Dark/panel/audio-volume-high-symbolic.svg \\\"\"p\"\\\" -h string:x-canonical-private-synchronous:sink-state\")}}else if(devs==1){for(k in a){print a[k];system(\"notify-send --urgency=low --icon=/run/current-system/sw/share/icons/Flat-Remix-Red-Dark/panel/audio-volume-high-symbolic.svg \\\"\"k\"\\\" -h string:x-canonical-private-synchronous:sink-state\")}}}') >/dev/null && pw-play --volume=0.2 /run/current-system/sw/share/sounds/freedesktop/stereo/audio-volume-change.oga >/dev/null &!",
				"on-click-right": "wpctl set-mute @DEFAULT_SINK@ toggle",
		"on-scroll-down": "wpctl set-volume @DEFAULT_SINK@ 5%- -l 2.0",
		"on-scroll-up": "wpctl set-volume @DEFAULT_SINK@ 5%+ -l 2.0",
		"scroll-step": "5",
		"smooth-scrolling-threshold": "4",
		"tooltip": true
	},
	"wireplumber#icon": {
		"format": "{volume:2} {icon:1}",
		"format-bluetooth": "{volume:2} {icon:1}",
		"format-icons": {
			"headphone": "󰋋",
			"headphone-muted": "󰟎",
			"hdmi": "󰔂 ",
			"hdmi-muted": "󰠻",
			"hands-free": "󱡏",
			"hands-free-muted": "󱡐",
			"headset": "󰋎",
			"headset-muted": "󰋐",
			"phone": "󰏲",
			"phone-muted": "󰷯",
			"portable": "󰏲",
			"portable-muted": "󰷯",
			"car": "󰄋",
			"car-muted": "󰸜",
			"default": ["󰖀", "󰕾"],
			"default-muted": "󰝟"
		},
		"format-muted": "{volume:2} 󰝟",
//		"format-muted": "{volume:2} {icon:1}",
		"ignored-sinks": ["Easy Effects Sink"],
		"on-click": "pkill -15 pavucontrol ; pavucontrol",
		"on-click-middle": "wpctl set-default $(pw-dump | jaq -r '.[]|select(.type==\"PipeWire:Interface:Node\" and .info.props[\"media.class\"]==\"Audio/Sink\")|[.id,.info.props[\"node.name\"],.info.props[\"node.description\"]]|@tsv' | awk -F'\\t' -v d=\"$(wpctl inspect @DEFAULT_AUDIO_SINK@|awk -F'\\\"' '/node.name/{print $2;exit}')\" 'BEGIN{c=\"walker -x -d -p \\\"Audio Device: \\\"\"}$2!=d&&$2!=\"easyeffects_sink\"{a[$3]=$1;devs++;print $3|&c}END{if(devs>1){close(c,\"to\");c|&getline p;if(p!=\"\"){print a[p];system(\"notify-send --urgency=low --icon=/run/current-system/sw/share/icons/Flat-Remix-Red-Dark/panel/audio-volume-high-symbolic.svg \\\"\"p\"\\\" -h string:x-canonical-private-synchronous:sink-state\")}}else if(devs==1){for(k in a){print a[k];system(\"notify-send --urgency=low --icon=/run/current-system/sw/share/icons/Flat-Remix-Red-Dark/panel/audio-volume-high-symbolic.svg \\\"\"k\"\\\" -h string:x-canonical-private-synchronous:sink-state\")}}}') >/dev/null && pw-play --volume=0.2 /run/current-system/sw/share/sounds/freedesktop/stereo/audio-volume-change.oga >/dev/null &!",
		"on-click-right": "wpctl set-mute @DEFAULT_SINK@ toggle",
		"on-scroll-down": "wpctl set-volume @DEFAULT_SINK@ 5%- -l 2.0",
		"on-scroll-up": "wpctl set-volume @DEFAULT_SINK@ 5%+ -l 2.0",
		"scroll-step": "5",
		"smooth-scrolling-threshold": "4",
		"tooltip": true
	},

	"pulseaudio/slider": {
		"max": 100,
		"min": 0,
		"orientation": "horizontal"
	},
	"custom/space": {
		"format": "  ",
		"tooltip": false
	},
	"tray": {
		"spacing": 10
	},
	"battery#icon": {
		"format": "{capacity:2} {icon:1}",
		"format-charged": "{icon}",
		"format-charging": "{capacity:2} {icon:1}",
		"format-full": "{icon}",
		"format-icons": {
			"charged": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
			"charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅" ],
			"discharging": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹" ],
			"full": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
			"plugged": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
		},
		"format-plugged": "{icon}",
		"events": {
			"on-discharging-30": "notify-send --urgency=critical 'Battery Low' -h string:x-canonical-private-synchronous:battery-state",
			"on-discharging-5": "notify-send --urgency=critical 'Critical Battery level!' -h string:x-canonical-private-synchronous:battery-state",
			"on-charging-100": "notify-send --urgency=low 'Battery Full' -h string:x-canonical-private-synchronous:battery-state",
			"on-charging": "notify-send --urgency=low 'Battery Charging' -h string:x-canonical-private-synchronous:battery-state",
		},
		"interval": 10,
		"max-length": 25,
		"on-click": "gnome-power-statistics",
		"states": {
			"warning": 30,
			"critical": 5
		},
		"tooltip":false
	},
	"power-profiles-daemon": {
		"format": "{icon:1}",
		"format-icons": {
			"default": "",
			"performance": "",
			"balanced": "",
			"power-saver": ""
		},
		"tooltip": true,
		"tooltip-format": "Profile: {profile}\nDriver: {driver}"
	},
	"battery#time": {
		"format": "",
		"format-charging-100": "",
		"format-charging-99": "{time}",
		"format-charging-critical": "{time}",
		"format-charging-warning": "{time}",
		"format-discharging-99": "{time}",
		"format-full": "",
		"format-plugged": "",
		"format-time": "{H}:{m}",
		"interval": 5,
		"max-length": 25,
		"on-click": "gnome-power-statistics",
		"states": {
			"100": 100,
			"99": 99,
			"warning": 30,
			"critical": 5
		},
		"tooltip":false
	},
	"hyprland/window": {
		"max-length": 150,
		"separate-outputs": true,
		"tooltip": false
	},
	"custom/mako": {
		"exec": "printf '{\"alt\":\"%s\",\"tooltip\":\"%s\",\"class\":\"%s\"}' $(makoctl mode | rg -q 'do-not-disturb' && echo dnd || echo default) $(makoctl mode | tail -1) $(makoctl mode | tail -1)",
		"format": "{}{icon:1}",
		"format-icons": {
			"default":"󰂚",
			"dnd":"󰂛"
		},
		"interval": "once",
		"on-click": "makoctl restore",
		"on-click-middle": "makoctl restore && makoctl restore && makoctl restore && makoctl restore && makoctl restore && makoctl restore",
		"on-click-right": "makoctl mode -t do-not-disturb ; pkill -RTMIN+11 waybar",
		"on-scroll-down": "makoctl dismiss",
		"on-scroll-up": "makoctl restore",
		"return-type": "json",
		"signal": 11
	},
	"systemd-failed-units": {
		"format": "✗ {nr_failed}",
		"hide-on-ok": true,
		"system": true,
		"user": false
	},
	"privacy": {
		"icon-size": 13,
		"icon-spacing": 0,
		"modules": [
			{
				"type": "screenshare",
				"tooltip": true,
				"tooltip-icon-size": 24
			},
			{
				"type": "audio-in",
				"tooltip": true,
				"tooltip-icon-size": 24
			}
		],
		"transition-duration": 250
	},
