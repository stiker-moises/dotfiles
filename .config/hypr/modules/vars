$bindslist = hyprkeys --from-ctl --json | jaq -r --slurp "[.[]][0]" | jaq -r '.[] | "\(.mods) \(.key) \(.dispatcher) \(.arg)"' | walker -d -p "keys:"
$browser = zsh -c "${BROWSER:-librewolf > /dev/null }"
$clipshow = zsh -c "${CLIPBOARDMANAGERSHOW:-copyq show > /dev/null }"
$cliptype = sleep 0.3 && ydotool click 0xC0 > /dev/null && sleep 0.2 && copyq clipboard | ydotool type -d 3 -H 2 -f - > /dev/null &!
$files = zsh -c "${FILEMANAGER:-dolphin > /dev/null }"
$focusd = hyprctl dispatch fullscreen 0, unset > /dev/null ; hyprctl dispatch movefocus d > /dev/null && hyprctl dispatch alterzorder top, active > /dev/null
$focusl = hyprctl dispatch fullscreen 0, unset > /dev/null ; hyprctl dispatch movefocus l > /dev/null && hyprctl dispatch alterzorder top, active > /dev/null
$focusr = hyprctl dispatch fullscreen 0, unset > /dev/null ; hyprctl dispatch movefocus r > /dev/null && hyprctl dispatch alterzorder top, active > /dev/null
$focusu = hyprctl dispatch fullscreen 0, unset > /dev/null ; hyprctl dispatch movefocus u > /dev/null && hyprctl dispatch alterzorder top, active > /dev/null
$launcher = walker > /dev/null &!
$lightdown = brightnessctl set 10%- > /dev/null && swayosd-client --monitor "$(hyprctl monitors -j | jaq -r '.[] | select(.focused == true).name')" --brightness -0 > /dev/null &!
$lightup = brightnessctl set 10%+ > /dev/null && swayosd-client --monitor "$(hyprctl monitors -j | jaq -r '.[] | select(.focused == true).name')" --brightness +0 > /dev/null &!
$lock = systemctl sleep & pkill -15 tofi > /dev/null & powerprofilesctl set power-saver & pkill -15 tofi > /dev/null & pidof hyprlock || ( pkill -15 tofi > /dev/null & hyprlock -c ~/.config/hypr/hyprlock/hyprlock-screenshot.conf > /dev/null || while ! hyprlock -c ~/.config/hypr/hyprlock/hyprlock-startup.conf > /dev/null; do sleep 0.01 > /dev/null; done > /dev/null ) ; ( rg -qq 0 /sys/class/power_supply/*/online && powerprofilesctl set power-saver || powerprofilesctl set performance )
$mictoggle = wpctl set-mute @DEFAULT_SOURCE@ toggle > /dev/null ; wpctl get-volume @DEFAULT_SOURCE@ | rg -q 'MUTED' && notify-send '   Mic Muted' -h string:x-canonical-private-synchronous:mic-state > /dev/null || notify-send --urgency=low '   Mic unmuted' -h string:x-canonical-private-synchronous:mic-state > /dev/null &!
$notes = hyprctl dispatch closewindow class:zim > /dev/null & zim > /dev/null &!
$notificationdismiss = makoctl dismiss -g > /dev/null &!
$notificationinvoke = makoctl invoke > /dev/null &! ; makoctl dismiss -g > /dev/null &!
$passwordmanager = zsh -c "${PASSWORDMANAGER:-bitwarden > /dev/null }"
$power = ~/.config/scripts/power.sh
$screenshotmon = pkill -15 slurp > /dev/null & hyprctl -r keyword windowrule "noscreenshare 0, tag:noscreenshare" > /dev/null & wayshot -o $(hyprctl monitors -j | jaq -r '.[] | select(.focused) | .name') -f $(xdg-user-dir PICTURES)/.clipboard.png > /dev/null && hyprctl -r keyword windowrule "noscreenshare, tag:noscreenshare" > /dev/null && wl-copy --type image/png < $(xdg-user-dir PICTURES)/.clipboard.png && wl-paste > $(xdg-user-dir PICTURES)/.clipboard/$(date +'%s.png') && pw-play --volume=0.05 /run/current-system/sw/share/sounds/freedesktop/stereo/camera-shutter.oga > /dev/null || hyprctl -r keyword windowrule 'noscreenshare, tag:noscreenshare' > /dev/null &!
$screenshotsel = pkill -15 slurp > /dev/null ; wayshot -s "$(slurp -b 00000000 -s cc000090 -w 0 && hyprctl -r keyword windowrule 'noscreenshare 0, tag:noscreenshare' > /dev/null)" -f $(xdg-user-dir PICTURES)/.clipboard.png > /dev/null && hyprctl -r keyword windowrule 'noscreenshare, tag:noscreenshare' > /dev/null && wl-copy --type image/png < $(xdg-user-dir PICTURES)/.clipboard.png && wl-paste > $(xdg-user-dir PICTURES)/.clipboard/$(date +'%s.png') && pw-play --volume=0.05 /run/current-system/sw/share/sounds/freedesktop/stereo/camera-shutter.oga > /dev/null || hyprctl -r keyword windowrule 'noscreenshare, tag:noscreenshare' > /dev/null &!
$screenshottext = pkill -15 slurp >/dev/null; text="$(wayshot -s "$(slurp -b 00000000 -s cc000090 -w 0 && hyprctl -r keyword windowrule 'noscreenshare 0, tag:noscreenshare' >/dev/null)" --stdout | tesseract stdin stdout 2>/dev/null)"; [ -n "$(printf %s "$text" | tr -d '[:space:]')" ] && printf %s "$text" | wl-copy && hyprctl -r keyword windowrule "noscreenshare, tag:noscreenshare" >/dev/null && pw-play --volume=0.05 /run/current-system/sw/share/sounds/freedesktop/stereo/camera-shutter.oga >/dev/null || hyprctl -r keyword windowrule "noscreenshare, tag:noscreenshare" >/dev/null
$sinkswitch = wpctl set-default $(pw-dump | jaq -r '.[]|select(.type=="PipeWire:Interface:Node" and .info.props["media.class"]=="Audio/Sink")|[.id,.info.props["node.name"],.info.props["node.description"]]|@tsv' | awk -F'\t' -v d="$(wpctl inspect @DEFAULT_AUDIO_SINK@|awk -F'"' '/node.name/{print $2;exit}')" 'BEGIN{c="walker -x -d -p \"Audio Device: \""}$2!=d&&$2!="easyeffects_sink"{a[$3]=$1;devs++;print $3|&c}END{if(devs>1){close(c,"to");c|&getline p;if(p!=""){print a[p];system("notify-send --urgency=low --icon=/run/current-system/sw/share/icons/Flat-Remix-Red-Dark/panel/audio-volume-high-symbolic.svg \""p"\" -h string:x-canonical-private-synchronous:sink-state")}}else if(devs==1){for(k in a){print a[k];system("notify-send --urgency=low --icon=/run/current-system/sw/share/icons/Flat-Remix-Red-Dark/panel/audio-volume-high-symbolic.svg \""k"\" -h string:x-canonical-private-synchronous:sink-state")}}}') >/dev/null && pw-play --volume=0.2 /run/current-system/sw/share/sounds/freedesktop/stereo/audio-volume-change.oga >/dev/null &!
$speedread = alacritty --config-file ~/.config/alacritty/alacritty-speedreader.toml --class 'alacrittyspeedreader' -e zsh -c 'copyq clipboard | speedread -w 500' > /dev/null
$taskmanager = resources > /dev/null &!
$term = alacritty msg create-window > /dev/null || alacritty > /dev/null &
$voldown = wpctl set-mute @DEFAULT_SINK@ 0 > /dev/null && wpctl set-volume @DEFAULT_SINK@ 5%- -l 2.0 > /dev/null && ( swayosd-client --monitor "$(hyprctl monitors -j | jaq -r '.[] | select(.focused == true).name')" --output-volume -0 > /dev/null & pw-play --volume=0.2 /run/current-system/sw/share/sounds/freedesktop/stereo/audio-volume-change.oga > /dev/null )
$volmute = wpctl set-mute @DEFAULT_SINK@ toggle > /dev/null && ( swayosd-client --monitor "$(hyprctl monitors -j | jaq -r '.[] | select(.focused == true).name')" --output-volume +0 > /dev/null & pw-play --volume=0.2 /run/current-system/sw/share/sounds/freedesktop/stereo/audio-volume-change.oga > /dev/null )
$volup = wpctl set-mute @DEFAULT_SINK@ 0 > /dev/null && wpctl set-volume @DEFAULT_SINK@ 5%+ -l 2.0 > /dev/null && ( swayosd-client --monitor "$(hyprctl monitors -j | jaq -r '.[] | select(.focused == true).name')" --output-volume +0 > /dev/null & pw-play --volume=0.2 /run/current-system/sw/share/sounds/freedesktop/stereo/audio-volume-change.oga > /dev/null )
$workspacedown = hyprctl dispatch workspace r-1 | rg -qq 'ok' || hyprctl dispatch workspace emptynm > /dev/null
$workspacesenddown = hyprctl dispatch movetoworkspace r-1 | rg -qq 'ok' || hyprctl dispatch movetoworkspace emptynm
$workspacesendup = zsh -c '[ $(hyprctl activeworkspace -j | jaq .windows) -ge 2 ] > /dev/null && hyprctl dispatch movetoworkspace r+1 > /dev/null || hyprctl dispatch movetoworkspace m+1 > /dev/null'
$workspaceup = zsh -c '[ $(hyprctl activeworkspace -j | jaq .windows) -ge 1 ] > /dev/null && hyprctl dispatch workspace r+1 > /dev/null || hyprctl dispatch workspace m+1 > /dev/null'
$zoomin = cur=$(hyprctl getoption cursor:zoom_factor -j | jaq -r .float); next=$(awk -v c=$cur 'BEGIN{n=c*1.2; if(n-c<0.1)n=c+0.1; if(n>90)n=90; print n}'); hyprctl keyword cursor:zoom_factor $next
$zoomout = cur=$(hyprctl getoption cursor:zoom_factor -j | jaq -r .float); prev=$(awk -v c=$cur 'BEGIN{n=c*0.4; if(c-n<0.1)n=c-0.1; if(n<1)n=1; print n}'); hyprctl keyword cursor:zoom_factor $prev
